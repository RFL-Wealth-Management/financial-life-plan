{
  "name": "fflp-automation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "supabase": "npx --yes supabase@2.109.1",
    "db:login": "npm run supabase -- login",
    "db:link": "npm run supabase -- link",
    "db:push": "npm run supabase -- db push",
    "db:status": "npm run supabase -- migration list --linked",
    "db:new": "npm run supabase -- migration new",
    "db:types": "npm run supabase -- gen types typescript --linked --schema public > src/lib/database.types.ts",
    "functions:new": "npm run supabase -- functions new",
    "functions:serve": "npm run supabase -- functions serve",
    "functions:deploy": "npm run supabase -- functions deploy"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "docxtemplater": "^3.68.7",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "pizzip": "^3.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/react": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "storybook": "^10.5.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.1.0"
  }
}
